{
  "tools": [
    {
      "name": "screenshot",
      "description": "Capture the screen (or one window). Returns an image plus screenshot_id; pass that id with coordinates taken from this image.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "window": {
            "type": "string"
          },
          "max_dimension": {
            "description": "Default 1280",
            "type": "integer",
            "minimum": 64,
            "maximum": 4096
          },
          "format": {
            "type": "string",
            "enum": [
              "png",
              "jpeg",
              "webp"
            ]
          },
          "cursor": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "click",
      "description": "Click at a point.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "description": "X coordinate"
          },
          "y": {
            "type": "number",
            "description": "Y coordinate"
          },
          "screenshot_id": {
            "description": "Interpret x/y in the pixel space of this screenshot (recommended)",
            "type": "string"
          },
          "space": {
            "type": "string",
            "enum": [
              "screen",
              "window",
              "screenshot",
              "normalized"
            ]
          },
          "window": {
            "description": "Window id for space=window|normalized",
            "type": "string"
          },
          "button": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "middle"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "modifiers": {
            "description": "Modifiers held during the action: ctrl, shift, alt, super",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "x",
          "y"
        ]
      }
    },
    {
      "name": "double_click",
      "description": "Double-click at a point.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "description": "X coordinate"
          },
          "y": {
            "type": "number",
            "description": "Y coordinate"
          },
          "screenshot_id": {
            "description": "Interpret x/y in the pixel space of this screenshot (recommended)",
            "type": "string"
          },
          "space": {
            "type": "string",
            "enum": [
              "screen",
              "window",
              "screenshot",
              "normalized"
            ]
          },
          "window": {
            "description": "Window id for space=window|normalized",
            "type": "string"
          },
          "modifiers": {
            "description": "Modifiers held during the action: ctrl, shift, alt, super",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "x",
          "y"
        ]
      }
    },
    {
      "name": "move",
      "description": "Move the pointer.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "description": "X coordinate"
          },
          "y": {
            "type": "number",
            "description": "Y coordinate"
          },
          "screenshot_id": {
            "description": "Interpret x/y in the pixel space of this screenshot (recommended)",
            "type": "string"
          },
          "space": {
            "type": "string",
            "enum": [
              "screen",
              "window",
              "screenshot",
              "normalized"
            ]
          },
          "window": {
            "description": "Window id for space=window|normalized",
            "type": "string"
          }
        },
        "required": [
          "x",
          "y"
        ]
      }
    },
    {
      "name": "drag",
      "description": "Press at (x,y), drag to (to_x,to_y), release. Both points use the same coordinate space.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "description": "X coordinate"
          },
          "y": {
            "type": "number",
            "description": "Y coordinate"
          },
          "screenshot_id": {
            "description": "Interpret x/y in the pixel space of this screenshot (recommended)",
            "type": "string"
          },
          "space": {
            "type": "string",
            "enum": [
              "screen",
              "window",
              "screenshot",
              "normalized"
            ]
          },
          "window": {
            "description": "Window id for space=window|normalized",
            "type": "string"
          },
          "to_x": {
            "type": "number"
          },
          "to_y": {
            "type": "number"
          },
          "button": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "middle"
            ]
          },
          "modifiers": {
            "description": "Modifiers held during the action: ctrl, shift, alt, super",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          }
        },
        "required": [
          "x",
          "y",
          "to_x",
          "to_y"
        ]
      }
    },
    {
      "name": "scroll",
      "description": "Scroll the wheel at a point. dy>0 scrolls down, dx>0 scrolls right; units are wheel clicks.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "description": "X coordinate"
          },
          "y": {
            "type": "number",
            "description": "Y coordinate"
          },
          "screenshot_id": {
            "description": "Interpret x/y in the pixel space of this screenshot (recommended)",
            "type": "string"
          },
          "space": {
            "type": "string",
            "enum": [
              "screen",
              "window",
              "screenshot",
              "normalized"
            ]
          },
          "window": {
            "description": "Window id for space=window|normalized",
            "type": "string"
          },
          "dx": {
            "type": "number"
          },
          "dy": {
            "type": "number"
          },
          "modifiers": {
            "description": "Modifiers held during the action: ctrl, shift, alt, super",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "x",
          "y"
        ]
      }
    },
    {
      "name": "type_text",
      "description": "Type text into the focused window. mode=paste uses the clipboard (more robust for long or non-ASCII text).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "keystrokes",
              "paste"
            ]
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "press_key",
      "description": "Press a key (e.g. Enter, Escape, Tab, ArrowDown, F5, a) optionally with modifiers.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "modifiers": {
            "description": "Modifiers held during the action: ctrl, shift, alt, super",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "repeat": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "key"
        ]
      }
    },
    {
      "name": "hotkey",
      "description": "Press a key combination, e.g. [\"ctrl\",\"shift\",\"t\"] or [\"alt\",\"F4\"].",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "keys": {
            "minItems": 1,
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "keys"
        ]
      }
    },
    {
      "name": "list_windows",
      "description": "List top-level windows with ids, titles, bounds and focus.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "activate_window",
      "description": "Raise and focus a window.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "window": {
            "type": "string"
          }
        },
        "required": [
          "window"
        ]
      }
    },
    {
      "name": "launch_app",
      "description": "Launch a GUI application on the desktop (e.g. \"xterm\", \"firefox-esr\").",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "command"
        ]
      }
    },
    {
      "name": "get_ui_tree",
      "description": "Accessibility tree (flat, pre-order) for a window or the whole desktop. Use element_id + snapshot_id with ui_action.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "window": {
            "type": "string"
          },
          "max_depth": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "max_nodes": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 5000
          }
        }
      }
    },
    {
      "name": "find_element",
      "description": "Find accessible elements by role (button, text_field, menuitem, …), name, or states.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "name_contains": {
            "type": "string"
          },
          "value_contains": {
            "type": "string"
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "window": {
            "type": "string"
          },
          "max_results": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 200
          }
        }
      }
    },
    {
      "name": "ui_action",
      "description": "Perform an accessibility action on an element: press, focus, set_value, or any action name it lists. Does not move the mouse.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "snapshot_id": {
            "type": "string"
          },
          "element_id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "snapshot_id",
          "element_id",
          "action"
        ]
      }
    },
    {
      "name": "get_clipboard",
      "description": "Read the clipboard.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "set_clipboard",
      "description": "Set the clipboard text.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "run_command",
      "description": "Run a shell command in the desktop environment (non-interactive). Waits up to wait_ms (default 25 s) and returns {state, exit_code, stdout, stderr}. If it is still going, state is \"running\" with a job_id: the command keeps running, and you call command_output to wait for it. Use this for long commands (installs, builds) too.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "timeout_ms": {
            "description": "Kill the command after this long (default 1 h)",
            "type": "integer",
            "minimum": 1000,
            "maximum": 86400000
          },
          "wait_ms": {
            "description": "How long to wait before handing off (default 25000, max 50000)",
            "type": "integer",
            "minimum": 0,
            "maximum": 50000
          }
        },
        "required": [
          "command"
        ]
      }
    },
    {
      "name": "command_output",
      "description": "Wait for a command started by run_command (by job_id) and return its state and output. Pass stdout_offset/stderr_offset from the previous result to get only new output. cancel=true kills it.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "wait_ms": {
            "description": "Default 25000",
            "type": "integer",
            "minimum": 0,
            "maximum": 50000
          },
          "stdout_offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "stderr_offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cancel": {
            "type": "boolean"
          }
        },
        "required": [
          "job_id"
        ]
      }
    },
    {
      "name": "read_file",
      "description": "Read a text file (up to 1 MiB).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "write_file",
      "description": "Write a text file (creates parent directories).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "content"
        ]
      }
    }
  ]
}
