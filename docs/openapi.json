    "/api/v1/input/pointer": {
      "post": {
        "tags": [
          "input"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "click",
                      "move",
                      "down",
                      "up",
                      "drag",
                      "scroll"
                    ]
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "space": {
                    "type": "string",
                    "enum": [
                      "screen",
                      "window",
                      "screenshot",
                      "normalized"
                    ]
                  },
                  "screenshot_id": {
                    "type": "string"
                  },
                  "window": {
                    "type": "string"
                  },
                  "button": {
                    "type": "string",
                    "enum": [
                      "left",
                      "right",
                      "middle",
                      "back",
                      "forward"
                    ]
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  },
                  "modifiers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "to": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ]
                  },
                  "path": {
                    "type": "array",
                    "maxItems": 1000,
                    "items": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ]
                    }
                  },
                  "dx": {
                    "type": "number"
                  },
                  "dy": {
                    "type": "number"
                  },
                  "unit": {
                    "type": "string",
                    "enum": [
                      "line",
                      "pixel"
                    ]
                  },
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "delivery": {
                    "type": "string",
                    "enum": [
                      "foreground",
                      "background"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
