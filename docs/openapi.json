    "/api/v1/screenshot": {
      "get": {
        "summary": "Capture the screen",
        "tags": [
          "screen"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "png",
                "jpeg",
                "webp"
              ]
            },
            "in": "query",
            "name": "format",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "in": "query",
            "name": "quality",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 16,
              "maximum": 16384
            },
            "in": "query",
            "name": "max_dimension",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d+,\\d+,\\d+,\\d+$"
            },
            "in": "query",
            "name": "region",
            "required": false
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "window",
            "required": false
          },
          {
            "schema": {
