# Copy to .env (git-ignored) and edit. Variables set in the environment take precedence.

# Provider and its settings; the scheme selects the provider.
PROVIDER_URI=docker:///var/run/docker.sock
# PROVIDER_URI=opensource-server://manager.os.mieweb.org?site=1&domain=2
# OPENSOURCE_SERVER_API_KEY=

# Persistent VM desktops with automatic managed-save hibernation (Linux/KVM).
# Build the guest template and configure wildcard DNS/TLS first:
# see ../docs/libvirt-deployment.md.
# PROVIDER_URI=libvirt:///system
# LIBVIRT_IMAGE_DIR=/var/lib/ozwell-computer/images/current
# LIBVIRT_PUBLIC_URL=https://{id}.computers.example.com
# LIBVIRT_STORAGE_DIR=/var/lib/ozwell-computer
# LIBVIRT_SAVE_DIR=/var/lib/libvirt/qemu/save
# LIBVIRT_NETWORK=ozwell-computer
# LIBVIRT_SUBNET=192.168.230
# LIBVIRT_MEMORY_MIB=2048
# LIBVIRT_VCPUS=2
# Five minutes after all connections, requests, jobs, upgrades and leases end.
# Zero disables automatic saves; explicit hibernate_computer still works.
# ORCHESTRATOR_IDLE_MS=300000
# ORCHESTRATOR_IDLE_POLL_MS=15000

# Mac/OrbStack: use the dedicated checkpoint runtime, not the host Docker socket.
# The bootstrap script builds native images and supplies the matching CRIU kit:
# see ../docs/docker-checkpoint-deployment.md.
# PROVIDER_URI=docker-checkpoint:///run/ozwell-docker/docker.sock?image=ozwell-computer:checkpoint-arm64-flat&network=bridge
# COMPUTER_GATEWAY_URL=https://{id}.ozwell-computers.local
# DOCKER_CHECKPOINT_DAEMON_SOCKET=/run/ozwell-docker/docker.sock
# DOCKER_CHECKPOINT_LOCK_DIR=/state

# Pre-shared key Ozwell sends as "Authorization: Bearer <token>". Generate one with:
#   openssl rand -base64 32
ORCHESTRATOR_TOKEN=

# ORCHESTRATOR_HOST=127.0.0.1
# ORCHESTRATOR_PORT=8090
# Computers each user may have (unset: unlimited).
# ORCHESTRATOR_MAX_INSTANCES=3
# LOG_LEVEL=info

# Origins allowed to embed new computers' viewers in an iframe (space separated).
# COMPUTER_FRAME_ANCESTORS=https://app.ozwell.ai
