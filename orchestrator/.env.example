# Copy to .env (git-ignored) and edit. Variables set in the environment take precedence.

# Provider and its settings; the scheme selects the provider.
PROVIDER_URI=docker:///var/run/docker.sock
# (With compose.yml, the docker:// provider is set by compose.docker.yml instead.)
# PROVIDER_URI=opensource-server://manager.os.mieweb.org?site=1&domain=2
# OPENSOURCE_SERVER_API_KEY=

# Pre-shared key Ozwell sends as "Authorization: Bearer <token>". Generate one with:
#   openssl rand -base64 32
ORCHESTRATOR_TOKEN=

# ORCHESTRATOR_HOST=127.0.0.1
# ORCHESTRATOR_PORT=8090
# Computers each user may have (unset: unlimited).
# ORCHESTRATOR_MAX_INSTANCES=3
# LOG_LEVEL=info

# Origins allowed to embed new computers' viewers in an iframe (space separated).
# COMPUTER_FRAME_ANCESTORS=https://app.ozwell.ai

# Observability, without compose (compose.yml sets these itself). Unset: off.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://victoriatraces:10428/insert/opentelemetry/v1/traces
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://victorialogs:9428/insert/opentelemetry/v1/logs
# OTEL_SERVICE_NAME=ozwell-computer-orchestrator
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0
# Internal listener for vmagent; off loopback it needs ORCHESTRATOR_INTERNAL_TOKEN.
# ORCHESTRATOR_INTERNAL_HOST=127.0.0.1
# ORCHESTRATOR_INTERNAL_PORT=8091
# ORCHESTRATOR_SD_ADDRESS=orchestrator:8091
# ORCHESTRATOR_LOG_SHIP_URL=http://victorialogs:9428/insert/journald
# ORCHESTRATOR_LOG_POLL_MS=5000
# ORCHESTRATOR_OP_TIMEOUT_MS=600000

# ---- compose.yml only ----
# Required. Generate with: openssl rand -base64 32
ORCHESTRATOR_INTERNAL_TOKEN=
GF_SECURITY_ADMIN_PASSWORD=
# Grafana's public URL (behind the reverse proxy).
# GF_SERVER_ROOT_URL=https://grafana.example.com/
# compose.docker.yml only: stat -c %g /var/run/docker.sock
# DOCKER_GID=
