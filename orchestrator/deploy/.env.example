# orchestrator/deploy/.env: settings for compose.yml. Mode 0600 (it holds secrets).
# Orchestrator settings: see ../.env.example for all of them.
ORCHESTRATOR_TOKEN=change-me
# PROVIDER_URI=docker:///var/run/docker.sock?network=ozwell-observability
# The group that owns /var/run/docker.sock on the host (docker:// provider): stat -c %g /var/run/docker.sock
# DOCKER_GID=999

# With `--profile observability`: point the orchestrator at the stack.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://victoriatraces:10428/insert/opentelemetry/v1/traces
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://victorialogs:9428/insert/opentelemetry/v1/logs
ORCHESTRATOR_LOG_SHIP_URL=http://victorialogs:9428/insert/journald

# Grafana: the only observability service with a published port. Local admin only.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
# The URL users reach through the reverse proxy; with a sub-path also set
# GF_SERVER_SERVE_FROM_SUB_PATH=true. The proxy must forward websockets (Grafana Live).
# GF_SERVER_ROOT_URL=https://grafana.example.com/
# GRAFANA_BIND=127.0.0.1
# GRAFANA_PORT=3000
# ORCHESTRATOR_BIND=127.0.0.1
# ORCHESTRATOR_PUBLISH_PORT=8090
