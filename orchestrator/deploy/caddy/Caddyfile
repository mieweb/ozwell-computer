# Routes MCP traffic to every orchestrator replica, so `docker rollout orchestrator` can
# swap them without dropping calls (README.md, "Updating without dropping calls").
{
	admin off
	auto_https off
}

:8090 {
	reverse_proxy {
		# Every orchestrator replica, from compose DNS, re-resolved every second.
		dynamic a orchestrator 8090 {
			refresh 1s
			versions ipv4
		}
		# A replica that is starting or draining refuses connections: try another one, and
		# hold the request up to 30 s when none answers yet (a plain restart).
		lb_try_duration 30s
		transport http {
			dial_timeout 1s
			# A new connection per request: a failure is then always at connect time, before
			# the request was sent, which Caddy retries even for POST.
			keepalive off
		}
	}
}

# grafana-mcp (README.md, "LLM access for root-cause analysis"): its own port, so a public
# route to the orchestrator never exposes it. grafana-mcp checks the caller token
# (MCP_GRAFANA_SERVER_TOKEN) itself.
:8092 {
	reverse_proxy grafana-mcp:8000 {
		# The one Host grafana-mcp accepts (--allowed-hosts): it guards against DNS rebinding.
		header_up Host grafana-mcp:8000
		# Callers can't pick another Grafana, org or credential: every call uses the
		# Viewer service account token from grafana-mcp-token.
		header_up -X-Grafana-*
	}
}
