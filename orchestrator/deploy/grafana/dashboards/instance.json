{
  "uid": "instance",
  "title": "Instance drill-down",
  "description": "One computer: metrics and its journal. Unit defaults to ozwell-computer.service.",
  "editable": false,
  "tags": [
    "ozwell-computer"
  ],
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "instance_id",
        "label": "Computer",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(up{job=\"computers\"}, instance_id)",
          "refId": "V"
        },
        "definition": "label_values(up{job=\"computers\"}, instance_id)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "allValue": ".*",
        "current": {}
      },
      {
        "name": "unit",
        "label": "Unit",
        "type": "custom",
        "query": "ozwell-computer.service : ozwell-computer\\\\.service,ozwell-computer-desktop.service : ozwell-computer-desktop\\\\.service,all units : .*",
        "current": {
          "text": "ozwell-computer.service",
          "value": "ozwell-computer\\\\.service"
        },
        "options": [
          {
            "text": "ozwell-computer.service",
            "value": "ozwell-computer\\\\.service",
            "selected": true
          },
          {
            "text": "ozwell-computer-desktop.service",
            "value": "ozwell-computer-desktop\\\\.service",
            "selected": false
          },
          {
            "text": "all units",
            "value": ".*",
            "selected": false
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "table",
      "title": "Computer",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 0,
        "y": 0
      },
      "options": {
        "showHeader": false,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Field"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "label_replace(label_replace(label_replace(label_replace(max by (user, display_name, provider, created_at) (ozwell_orchestrator_computer_info{instance_id=\"$instance_id\"}), \"user\", \"none\", \"user\", \"\"), \"display_name\", \"none\", \"display_name\", \"\"), \"provider\", \"none\", \"provider\", \"\"), \"created_at\", \"none\", \"created_at\", \"\")",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (version) (ozwell_build_info{instance_id=\"$instance_id\"}) or on() label_replace(max(up{job=\"computers\", instance_id=\"$instance_id\"}), \"version\", \"older (no version metric)\", \"\", \"\")",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "Time",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Value #A": true,
              "Value #B": true
            },
            "renameByName": {
              "user": "Owner",
              "version": "Version",
              "display_name": "Display name",
              "provider": "Provider",
              "created_at": "Created"
            },
            "indexByName": {
              "Time": 0,
              "user": 1,
              "version": 2,
              "display_name": 3,
              "provider": 4,
              "created_at": 5
            }
          }
        },
        {
          "id": "transpose",
          "options": {}
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Scrape up",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max(up{job=\"computers\", instance_id=\"$instance_id\"})",
          "instant": true
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "X connected",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 13,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max(ozwell_x_connected{instance_id=\"$instance_id\"})",
          "instant": true
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Server uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "time() - max(process_start_time_seconds{job=\"computers\", instance_id=\"$instance_id\"})",
          "instant": true
        }
      ],
      "id": 4
    },
    {
      "type": "stat",
      "title": "Memory",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max(ozwell_cgroup_memory_bytes{scope=\"container\", instance_id=\"$instance_id\"})",
          "instant": true
        }
      ],
      "id": 5
    },
    {
      "type": "stat",
      "title": "Memory limit",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max(ozwell_cgroup_memory_limit_bytes{instance_id=\"$instance_id\"})",
          "instant": true
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "CPU (cores)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (instance_id) (rate(ozwell_cgroup_cpu_seconds_total{instance_id=\"$instance_id\"}[$__rate_interval]))",
          "legendFormat": "cpu",
          "exemplar": false
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Memory by command (PSS)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "topk(8, max by (command) (ozwell_process_pss_bytes{instance_id=\"$instance_id\"}))",
          "legendFormat": "{{command}}",
          "exemplar": false
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 by route",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(ozwell_http_request_duration_seconds_bucket{instance_id=\"$instance_id\"}[$__rate_interval])))",
          "legendFormat": "{{route}}",
          "exemplar": false
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "MCP tool calls",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (tool, outcome) (rate(ozwell_mcp_tool_calls_total{instance_id=\"$instance_id\"}[$__rate_interval]))",
          "legendFormat": "{{tool}} {{outcome}}",
          "exemplar": false
        }
      ],
      "id": 10
    },
    {
      "type": "logs",
      "title": "Journal",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "w": 24,
        "h": 14,
        "x": 0,
        "y": 24
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "OZWELL_INSTANCE_ID:=\"$instance_id\" _SYSTEMD_UNIT:~\"^($unit)$\" | sort by (_time desc)",
          "queryType": "instant"
        }
      ],
      "id": 11
    }
  ],
  "links": [
    {
      "title": "ozwell-computer dashboards",
      "type": "dashboards",
      "tags": [
        "ozwell-computer"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ]
}
