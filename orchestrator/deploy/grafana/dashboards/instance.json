{
  "uid": "instance",
  "title": "Instance drill-down",
  "description": "One computer: metrics, the tool calls and commands run on it (traces), and its journal. Unit defaults to ozwell-computer.service.",
  "editable": false,
  "tags": [
    "ozwell-computer"
  ],
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "instance_id",
        "label": "Computer",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(up{job=\"computers\"}, instance_id)",
          "refId": "V"
        },
        "definition": "label_values(up{job=\"computers\"}, instance_id)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "allValue": ".*",
        "current": {}
      },
      {
        "name": "unit",
        "label": "Unit",
        "type": "custom",
        "query": "ozwell-computer.service : ozwell-computer\\\\.service,ozwell-computer-desktop.service : ozwell-computer-desktop\\\\.service,all units : .*",
        "current": {
          "text": "ozwell-computer.service",
          "value": "ozwell-computer\\\\.service"
        },
        "options": [
          {
            "text": "ozwell-computer.service",
            "value": "ozwell-computer\\\\.service",
            "selected": true
          },
          {
            "text": "ozwell-computer-desktop.service",
            "value": "ozwell-computer-desktop\\\\.service",
            "selected": false
          },
          {
            "text": "all units",
            "value": ".*",
            "selected": false
          }
        ]
      },
      {
        "name": "calls",
        "label": "Calls",
        "type": "custom",
        "description": "Tool calls table: all calls, or only failed ones",
        "query": "all : *,errors only : =2",
        "current": {
          "text": "all",
          "value": "*"
        },
        "options": [
          {
            "text": "all",
            "value": "*",
            "selected": true
          },
          {
            "text": "errors only",
            "value": "=2",
            "selected": false
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "table",
      "title": "Computer",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 0,
        "y": 0
      },
      "options": {
        "showHeader": false,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Field"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "label_replace(label_replace(label_replace(label_replace(max by (user, display_name, provider, created_at) (ozwell_orchestrator_computer_info{instance_id=\"$instance_id\"}), \"user\", \"none\", \"user\", \"\"), \"display_name\", \"none\", \"display_name\", \"\"), \"provider\", \"none\", \"provider\", \"\"), \"created_at\", \"none\", \"created_at\", \"\")",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (version) (ozwell_build_info{instance_id=\"$instance_id\"}) or on() label_replace(max(up{job=\"computers\", instance_id=\"$instance_id\"} == 1), \"version\", \"older (no version metric)\", \"\", \"\") or on() label_replace(max(up{job=\"computers\", instance_id=\"$instance_id\"} == 0), \"version\", \"unknown (scrape failing)\", \"\", \"\")",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "Time",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Value #A": true,
              "Value #B": true
            },
            "renameByName": {
              "user": "Owner",
              "version": "Version",
              "display_name": "Display name",
              "provider": "Provider",
              "created_at": "Created"
            },
            "indexByName": {
              "Time": 0,
              "user": 1,
              "version": 2,
              "display_name": 3,
              "provider": 4,
              "created_at": 5
            }
          }
        },
        {
          "id": "transpose",
          "options": {}
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Scrape up",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max(up{job=\"computers\", instance_id=\"$instance_id\"})",
          "instant": true
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "X connected",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 13,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max(ozwell_x_connected{instance_id=\"$instance_id\"})",
          "instant": true
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Server uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "time() - max(process_start_time_seconds{job=\"computers\", instance_id=\"$instance_id\"})",
          "instant": true
        }
      ],
      "id": 4
    },
    {
      "type": "stat",
      "title": "Memory",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max(ozwell_cgroup_memory_bytes{scope=\"container\", instance_id=\"$instance_id\"})",
          "instant": true
        }
      ],
      "id": 5
    },
    {
      "type": "stat",
      "title": "Memory limit",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max(ozwell_cgroup_memory_limit_bytes{instance_id=\"$instance_id\"})",
          "instant": true
        }
      ],
      "id": 6
    },
    {
      "type": "table",
      "title": "Tool calls on this computer",
      "description": "MCP tool calls the orchestrator made to this computer in the time range, newest first (at most 200). Arguments include the command for run_command. Click a trace id to open the trace: the orchestrator's spans and the computer's (mcp.tool, exec, screenshot, input, a11y). Use the Calls variable to show only errors.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoriatraces-spans"
      },
      "id": 13,
      "gridPos": {
        "w": 24,
        "h": 10,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoriatraces-spans"
          },
          "expr": "\"resource_attr:service.name\":=\"ozwell-computer-orchestrator\" \"span_attr:mcp.method.name\":=\"tools/call\" \"span_attr:ozwell.instance_id\":=\"$instance_id\" status_code:$calls | math round(duration / 1e6) as duration_ms | fields _time, \"span_attr:gen_ai.tool.name\", duration_ms, status_code, \"span_attr:error.type\", \"span_attr:ozwell.tool.arguments\", trace_id | sort by (_time desc) | limit 200",
          "queryType": "instant",
          "maxLines": 200
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "replace": true,
            "keepTime": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "_time": true
            },
            "indexByName": {
              "Time": 0,
              "span_attr:gen_ai.tool.name": 1,
              "duration_ms": 2,
              "status_code": 3,
              "span_attr:error.type": 4,
              "span_attr:ozwell.tool.arguments": 5,
              "trace_id": 6
            },
            "renameByName": {
              "Time": "Time",
              "span_attr:gen_ai.tool.name": "Tool",
              "duration_ms": "Duration (ms)",
              "status_code": "Status",
              "span_attr:error.type": "Error",
              "span_attr:ozwell.tool.arguments": "Arguments"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Trace"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace",
                    "url": "",
                    "internal": {
                      "datasourceUid": "victoriatraces",
                      "datasourceName": "VictoriaTraces",
                      "query": {
                        "query": "${__value.raw}"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 290
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "span_attr:gen_ai.tool.name"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration_ms"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status_code"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "span_attr:error.type"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status_code"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "ok",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "ok",
                        "color": "green",
                        "index": 1
                      },
                      "2": {
                        "text": "error",
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Commands run on this computer (exec spans)",
      "description": "The computer's own exec spans: run_command and the exec API. A background job's span lasts until the command ends (to about a second), even when the tool call that started it returned earlier, so long-running commands show their real duration and exit code here. The command itself is in the trace's tool-call arguments (click the trace id). Spans arrive up to a poll interval (5 s) plus indexing (about 20 s) late.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoriatraces-spans"
      },
      "id": 14,
      "gridPos": {
        "w": 24,
        "h": 8,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoriatraces-spans"
          },
          "expr": "\"resource_attr:service.name\":=\"ozwell-computer\" \"resource_attr:ozwell.instance_id\":=\"$instance_id\" name:=\"exec\" | math round(duration / 1e6) as duration_ms | fields _time, duration_ms, \"span_attr:exec.job_id\", \"span_attr:exec.state\", \"span_attr:process.exit.code\", \"span_attr:exec.timed_out\", status_message, trace_id | sort by (_time desc) | limit 200",
          "queryType": "instant",
          "maxLines": 200
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "replace": true,
            "keepTime": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "_time": true
            },
            "indexByName": {
              "Time": 0,
              "duration_ms": 1,
              "span_attr:exec.job_id": 2,
              "span_attr:exec.state": 3,
              "span_attr:process.exit.code": 4,
              "span_attr:exec.timed_out": 5,
              "status_message": 6,
              "trace_id": 7
            },
            "renameByName": {
              "duration_ms": "Duration (ms)",
              "span_attr:exec.job_id": "Job",
              "span_attr:exec.state": "State",
              "span_attr:process.exit.code": "Exit code",
              "span_attr:exec.timed_out": "Timed out",
              "status_message": "Error"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Trace"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace",
                    "url": "",
                    "internal": {
                      "datasourceUid": "victoriatraces",
                      "datasourceName": "VictoriaTraces",
                      "query": {
                        "query": "${__value.raw}"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 290
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration_ms"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "span_attr:exec.job_id"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "span_attr:exec.state"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "span_attr:process.exit.code"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "span_attr:exec.timed_out"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "CPU (cores)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (instance_id) (rate(ozwell_cgroup_cpu_seconds_total{instance_id=\"$instance_id\"}[$__rate_interval]))",
          "legendFormat": "cpu",
          "exemplar": false
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Pressure (share of time stalled)",
      "description": "Share of time tasks were stalled waiting for the resource (Linux PSI). some: at least one task waited; full: every task did (no progress at all). Sustained some above ~10% is contention; any full is serious.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "y": 26,
        "x": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (resource, kind) (rate(ozwell_cgroup_pressure_seconds_total{instance_id=\"$instance_id\"}[$__rate_interval]))",
          "legendFormat": "{{resource}} {{kind}}"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Memory by command (PSS)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "topk(8, max by (command) (ozwell_process_pss_bytes{instance_id=\"$instance_id\"}))",
          "legendFormat": "{{command}}",
          "exemplar": false
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 by route",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(ozwell_http_request_duration_seconds_bucket{instance_id=\"$instance_id\"}[$__rate_interval])))",
          "legendFormat": "{{route}}",
          "exemplar": false
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "MCP tool calls",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 42
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (tool, outcome) (rate(ozwell_mcp_tool_calls_total{instance_id=\"$instance_id\"}[$__rate_interval]))",
          "legendFormat": "{{tool}} {{outcome}}",
          "exemplar": false
        }
      ],
      "id": 11
    },
    {
      "type": "logs",
      "title": "Journal",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "w": 24,
        "h": 14,
        "x": 0,
        "y": 50
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "OZWELL_INSTANCE_ID:=\"$instance_id\" _SYSTEMD_UNIT:~\"^($unit)$\" | sort by (_time desc)",
          "queryType": "instant"
        }
      ],
      "id": 12
