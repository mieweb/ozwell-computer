{
  "uid": "fleet",
  "title": "Fleet",
  "description": "Every running computer, scraped through the orchestrator.",
  "editable": false,
  "tags": [
    "ozwell-computer"
  ],
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "instance_id",
        "label": "Computer",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(up{job=\"computers\"}, instance_id)",
          "refId": "V"
        },
        "definition": "label_values(up{job=\"computers\"}, instance_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Running computers (scraped)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "count(up{job=\"computers\"})",
          "instant": true
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Scrapes failing",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "count(up{job=\"computers\"} == 0) or vector(0)",
          "instant": true
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Instances without the logs route",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max(ozwell_orchestrator_log_pull_unsupported_instances)",
          "instant": true
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Orchestrator up",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max(up{job=\"orchestrator\"})",
          "instant": true
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Computers by user",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "count by (user) (ozwell_orchestrator_computer_info and on (instance_id) up{job=\"computers\"})",
          "legendFormat": "{{user}}",
          "exemplar": false
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Scrape up",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (instance_id) (up{job=\"computers\", instance_id=~\"$instance_id\"})",
          "legendFormat": "{{instance_id}}",
          "exemplar": false
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Memory",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (instance_id) (ozwell_cgroup_memory_bytes{scope=\"container\", instance_id=~\"$instance_id\"})",
          "legendFormat": "{{instance_id}}",
          "exemplar": false
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "CPU (cores)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (instance_id) (rate(ozwell_cgroup_cpu_seconds_total{instance_id=~\"$instance_id\"}[$__rate_interval]))",
          "legendFormat": "{{instance_id}}",
          "exemplar": false
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "HTTP requests p95",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.95, sum by (le, instance_id) (rate(ozwell_http_request_duration_seconds_bucket{instance_id=~\"$instance_id\"}[$__rate_interval])))",
          "legendFormat": "{{instance_id}}",
          "exemplar": false
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "MCP tool calls on instances",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (instance_id) (rate(ozwell_mcp_tool_calls_total{instance_id=~\"$instance_id\"}[$__rate_interval]))",
          "legendFormat": "{{instance_id}}",
          "exemplar": false
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Open VNC sessions",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (instance_id) (ozwell_vnc_sessions{instance_id=~\"$instance_id\"})",
          "legendFormat": "{{instance_id}}",
          "exemplar": false
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Log pulls by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (outcome) (rate(ozwell_orchestrator_log_pulls_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "exemplar": false
        }
      ],
      "id": 12
    },
    {
      "type": "piechart",
      "title": "Versions",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 36
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "count by (version) (ozwell_build_info{job=\"computers\"}) or label_replace(count(up{job=\"computers\"} unless on (instance_id) ozwell_build_info), \"version\", \"older (no version metric)\", \"\", \"\")",
          "legendFormat": "{{version}}",
          "instant": true
        }
      ],
      "id": 13
    }
  ],
  "links": [
    {
      "title": "ozwell-computer dashboards",
      "type": "dashboards",
      "tags": [
        "ozwell-computer"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ]
}
