{
  "name": "@mieweb/ozwell-computer-orchestrator",
  "version": "0.0.0",
  "private": true,
  "description": "Stateless MCP orchestrator for per-user ozwell-computer instances",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import ./src/telemetry.ts src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/otel": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentelemetry/api": "^1.10.0",
