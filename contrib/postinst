#!/bin/sh
# ozwell-computer postinst
set -e

# Never stop or restart ozwell-computer-upgrade.service here (or in prerm): in-app
# upgrades run apt/dpkg *inside* that service, so doing so would kill this very
# transaction halfway. test/unit/packaging.test.ts enforces this.
UNITS="ozwell-computer-desktop.service ozwell-computer-upgrade.path"
# Before ozwell-computer-desktop.service, Xvfb, the session bus, the session and the
# server were separate system units.
LEGACY_UNITS="ozwell-computer.service ozwell-computer-session.service ozwell-computer-xvfb.service ozwell-computer-dbus.service"
WANTS=/etc/systemd/system/multi-user.target.wants

# The server is a user unit of "desktop", in the user manager its desktop session
# starts. `-M desktop@` would start that manager if it isn't running: skip it then.
user_systemctl() {
    systemctl is-active --quiet "user@$(id -u desktop).service" || return 0
    systemctl --user -M desktop@ "$@"
}

case "$1" in
    configure)
        # Unprivileged user that owns the X display, the desktop session and the server.
        if ! getent passwd desktop >/dev/null; then
            adduser --system --group --home /home/desktop --shell /bin/bash \
                --gecos "ozwell-computer session" desktop
        fi

        command -v systemctl >/dev/null 2>&1 || exit 0

        # dpkg has removed the legacy unit files; drop their links, keeping them enabled.
        legacy=
        for u in $LEGACY_UNITS; do
            if [ -L "$WANTS/$u" ]; then rm -f "$WANTS/$u"; legacy=1; fi
        done

        # Enable on first install only ($2 is the previously configured version),
        # so an administrator's `systemctl disable` survives upgrades. Enabling only
        # creates symlinks, so it also works during an image build.
        if [ -z "$2" ] || [ -n "$legacy" ]; then
            systemctl enable $UNITS >/dev/null
        fi

        # Starting needs a running systemd (not the case during an image build).
        if [ -d /run/systemd/system ]; then
            running=
            for u in $LEGACY_UNITS; do
                if systemctl is-active --quiet "$u"; then running=1; fi
            done
            if [ -n "$running" ]; then
                # Replace the legacy units: this once, the desktop restarts.
                systemctl stop $LEGACY_UNITS || true
            fi
            systemctl daemon-reload
            if [ -z "$2" ] || [ -n "$running" ]; then
                # The desktop session starts the server.
                systemctl start $UNITS
            else
                # Upgrade: restart only the server. Restarting the desktop would close
                # every application open on it.
                user_systemctl daemon-reload
                user_systemctl try-restart ozwell-computer.service
                # Pick up a changed watch definition. Stopping a path unit doesn't
                # stop the service it triggered (possibly the one running us).
                systemctl try-restart ozwell-computer-upgrade.path
            fi
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
