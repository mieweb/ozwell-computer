# Settings for the ozwell-computer services (read by ozwell-computer.service,
# ozwell-computer-xvfb.service and ozwell-computer-upgrade.service). See
# `ozwell-computer --help` for every option.
# Restart after editing: systemctl restart ozwell-computer-xvfb ozwell-computer

# Access token. If unset, one is generated and kept in /var/lib/ozwell-computer/token.
#OZWELL_COMPUTER_TOKEN=

# Listen address and port (the address defaults to 127.0.0.1 outside containers).
#OZWELL_COMPUTER_HOST=0.0.0.0
#OZWELL_COMPUTER_PORT=8080

# Virtual screen geometry (WIDTHxHEIGHTxDEPTH).
#OZWELL_COMPUTER_SCREEN=1920x1080x24

# Disable the process, file and app-launch APIs.
#OZWELL_COMPUTER_EXEC=false
