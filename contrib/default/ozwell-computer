# Settings for the ozwell-computer services (read by ozwell-computer-desktop.service,
# ozwell-computer-upgrade.service and the desktop user's ozwell-computer.service). See
# `ozwell-computer --help` for every option.
# Restart after editing: systemctl --user -M desktop@ restart ozwell-computer
# (the screen size: systemctl restart ozwell-computer-desktop, which restarts the session)

# Access token. If unset, one is generated and kept in /var/lib/ozwell-computer/token.
#OZWELL_COMPUTER_TOKEN=

# Listen address and port (the address defaults to 127.0.0.1 outside containers).
#OZWELL_COMPUTER_HOST=0.0.0.0
#OZWELL_COMPUTER_PORT=8080

# Virtual screen geometry (WIDTHxHEIGHTxDEPTH).
#OZWELL_COMPUTER_SCREEN=1920x1080x24

# Disable the process, file and app-launch APIs.
#OZWELL_COMPUTER_EXEC=false

# Other origins allowed to embed the viewer in an iframe (CSP frame-ancestors).
#OZWELL_COMPUTER_FRAME_ANCESTORS=https://app.ozwell.ai

# CPU capacity for the toolbar's CPU %, when a limit isn't visible inside the container
# (e.g. a Proxmox LXC cpulimit around a Docker host).
#OZWELL_COMPUTER_CPUS=2
