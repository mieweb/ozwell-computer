[Unit]
Description=ozwell-desktop session D-Bus (shared by the desktop session and the server)
PartOf=ozwell-desktop.service

[Service]
User=desktop
RuntimeDirectory=desktop-bus
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/dbus-daemon --session --nofork --nopidfile --address=unix:path=/run/desktop-bus/bus
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
