[Unit]
Description=ozwell-desktop virtual X server (Xvfb :0)

[Service]
User=desktop
Environment=OZWELL_DESKTOP_SCREEN=1920x1080x24
EnvironmentFile=-/etc/default/ozwell-desktop
ExecStart=/bin/sh -c 'exec /usr/bin/Xvfb :0 -screen 0 "$OZWELL_DESKTOP_SCREEN" -nolisten tcp +extension RANDR +extension DAMAGE -dpi 96'
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
