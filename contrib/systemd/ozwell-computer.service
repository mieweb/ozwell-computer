[Unit]
Description=ozwell-computer (noVNC + HTTP API + MCP)
After=ozwell-computer-session.service ozwell-computer-dbus.service network.target
Wants=ozwell-computer-session.service
StartLimitIntervalSec=0

[Service]
User=desktop
WorkingDirectory=~
StateDirectory=ozwell-computer
StateDirectoryMode=0700
Environment=DISPLAY=:0 OZWELL_COMPUTER_TOKEN_FILE=/var/lib/ozwell-computer/token
# Apps launched through the API join the desktop's session bus and expose AT-SPI
# GNOME_ACCESSIBILITY=1: Firefox (and others) only expose AT-SPI when told an AT is present.
Environment=GNOME_ACCESSIBILITY=1 GSK_RENDERER=cairo LIBGL_ALWAYS_SOFTWARE=1 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/desktop-bus/bus GTK_MODULES=gail:atk-bridge NO_AT_BRIDGE=0 QT_ACCESSIBILITY=1 QT_LINUX_ACCESSIBILITY_ALWAYS_ON=1
EnvironmentFile=-/etc/default/ozwell-computer
ExecStart=/usr/bin/node @PREFIX@/dist/cli.js
Restart=always
RestartSec=1
NoNewPrivileges=yes
# Apps launched through the API run in this service's cgroup; restarting the
# server (e.g. after an upgrade) must not close them.
KillMode=process

[Install]
WantedBy=multi-user.target
