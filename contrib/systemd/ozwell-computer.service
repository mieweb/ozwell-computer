[Unit]
Description=ozwell-computer (noVNC + HTTP API + MCP)
# The desktop's login session provides X :0 and the user's session bus (/run/user/UID/bus).
After=ozwell-computer-desktop.service network.target
Requires=ozwell-computer-desktop.service
StartLimitIntervalSec=0

[Service]
User=desktop
WorkingDirectory=~
StateDirectory=ozwell-computer
StateDirectoryMode=0700
Environment=DISPLAY=:0 OZWELL_COMPUTER_TOKEN_FILE=/var/lib/ozwell-computer/token
# Apps launched through the API join the desktop's session bus and expose AT-SPI
# GNOME_ACCESSIBILITY=1: Firefox (and others) only expose AT-SPI when told an AT is present.
# The server sets XDG_RUNTIME_DIR and DBUS_SESSION_BUS_ADDRESS (/run/user/UID) itself:
# %U here would be root's UID, not desktop's.
Environment=GNOME_ACCESSIBILITY=1 GSK_RENDERER=cairo LIBGL_ALWAYS_SOFTWARE=1 GTK_MODULES=gail:atk-bridge NO_AT_BRIDGE=0 QT_ACCESSIBILITY=1 QT_LINUX_ACCESSIBILITY_ALWAYS_ON=1
EnvironmentFile=-/etc/default/ozwell-computer
ExecStart=/usr/bin/node @PREFIX@/dist/cli.js
Restart=always
RestartSec=1
NoNewPrivileges=yes
# Apps launched through the API run in this service's cgroup; restarting the
# server (e.g. after an upgrade) must not close them.
KillMode=process

[Install]
WantedBy=multi-user.target
