[Unit]
Description=ozwell-computer (noVNC + HTTP API + MCP)
# A user unit of "desktop". The desktop session starts it (xdg/autostart/ozwell-computer.desktop)
# once it has exported its environment (DISPLAY, the session bus, the accessibility
# modules) to the user manager, so the server and the apps it launches share them.
StartLimitIntervalSec=0

[Service]
WorkingDirectory=~
Environment=OZWELL_COMPUTER_TOKEN_FILE=/var/lib/ozwell-computer/token
EnvironmentFile=-/etc/default/ozwell-computer
ExecStart=/usr/bin/node @PREFIX@/dist/cli.js
Restart=always
RestartSec=1
NoNewPrivileges=yes
# Apps launched through the API run in this service's cgroup; restarting the
# server (e.g. after an upgrade) must not close them.
KillMode=process
