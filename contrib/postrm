#!/bin/sh
# ozwell-computer postrm
set -e

case "$1" in
    remove)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        ;;
    purge)
        # The generated access token and other state. The "desktop" user and its
        # home directory are kept: they may hold the user's files.
        rm -rf /var/lib/ozwell-computer
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
