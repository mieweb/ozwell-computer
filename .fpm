--name ozwell-computer
--architecture native
--license MIT
--maintainer "Medical Informatics Engineering <helpdesk@mieweb.com>"
--vendor "Medical Informatics Engineering"
--url "https://github.com/mieweb/ozwell-computer"
--category x11
--description "Headless X11 desktop served over one HTTP port: a noVNC viewer for people and an HTTP API plus MCP server for automation and AI agents."
--depends "nodejs (>= 24)"
--depends libc6
--depends libstdc++6
--depends adduser
--depends xvfb
--depends xinit
--depends x11-common
--depends libpam-runtime
--depends libpam-systemd
--depends xfwm4
--depends xfce4-session
--depends xfce4-panel
--depends xfdesktop4
--depends xfconf
--depends xfce4-settings
--depends xfce4-terminal
--depends thunar
--depends adwaita-icon-theme
--depends greybird-gtk-theme
--depends gnome-themes-extra-data
--depends dbus-daemon
--depends dbus-bin
--depends dbus-user-session
--depends at-spi2-core
--depends libatk-adaptor
--depends xdg-utils
--depends x11-xserver-utils
--depends xclip
--depends tesseract-ocr
--depends fonts-dejavu-core
--depends fonts-noto-core
--deb-suggests firefox-esr
--deb-suggests xterm
--deb-suggests zenity
--config-files /etc/default/ozwell-computer
--config-files /etc/pam.d/ozwell-computer
--config-files /etc/xdg/mimeapps.list
--config-files /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml
--config-files /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml
--config-files /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml
--deb-no-default-config-files
--after-install contrib/postinst
--before-remove contrib/prerm
--after-remove contrib/postrm
