{
  "name": "@mieweb/ozwell-computer",
  "version": "0.0.0",
  "description": "Serve an X11 desktop to humans (noVNC) and agents (HTTP API + MCP) on one port",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ozwell-computer": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build -c web/vite.config.ts -l warn",
    "dev": "tsx src/cli.ts",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --project integration",
    "pretest": "npm run build && playwright-core install chromium firefox",
    "test:unit": "vitest run --project unit",
    "pretest:integration": "npm run build && playwright-core install chromium firefox",
    "watch": "node scripts/watch.mjs",
    "prestart": "npm run build",
    "mcp-tools": "node dist/cli.js --print-mcp-tools > docs/mcp-tools.json"
  },
  "devDependencies": {
    "@mieweb/ui": "^0.11.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/websocket": "^11.3.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@novnc/novnc": "^1.7.0",
    "dbus-next": "^0.10.2",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "pngjs": "^7.0.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "ulid": "^3.0.2",
    "ws": "^8.22.0",
    "x11": "^4.3.3",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "allowScripts": {
    "esbuild": true,
    "node-pty": true,
    "usocket": true
  },
  "overrides": {
    "node-gyp": "^12.0.0",
    "xml2js": "^0.6.2"
  }
}
